<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Thetis</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS8981;CA2255;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <ConsoleDir>$(MSBuildThisFileDirectory)../../Console/</ConsoleDir>
  </PropertyGroup>
  <!-- upstream files compiled unmodified -->
  <ItemGroup>
    <Compile Include="$(ConsoleDir)HPSDR/clsRadioDiscovery.cs" Link="Upstream/clsRadioDiscovery.cs" />
    <Compile Include="$(ConsoleDir)dsp.cs" Link="Upstream/dsp.cs" />
    <Compile Include="$(ConsoleDir)ivac.cs" Link="Upstream/ivac.cs" />
    <Compile Include="$(ConsoleDir)enums.cs" Link="Upstream/enums.cs" />
    <Compile Include="$(ConsoleDir)clsHardwareSpecific.cs" Link="Upstream/clsHardwareSpecific.cs" />
    <Compile Include="$(ConsoleDir)HPSDR/NetworkIOImports.cs" Link="Upstream/NetworkIOImports.cs" />
    <Compile Include="$(ConsoleDir)HPSDR/specHPSDR.cs" Link="Upstream/specHPSDR.cs" />
    <Compile Include="$(ConsoleDir)HPSDR/Penny.cs" Link="Upstream/Penny.cs" />
  </ItemGroup>
  <!-- CAT: upstream's command table (parameter lengths per command), unmodified -->
  <ItemGroup>
    <EmbeddedResource Include="$(ConsoleDir)CAT/CATStructs.xml" Link="Upstream/CATStructs.xml" LogicalName="CATStructs.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
</Project>
