<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Thetis.Desktop.Controls"
        x:Class="Thetis.Desktop.MainWindow"
        Title="Thetis"
        Icon="/Assets/thetis.png"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Background="#12171C">

  <DockPanel>

    <!-- top bar: power, radio selection, status -->
    <Border DockPanel.Dock="Top" Background="#161C22" BorderBrush="#2C353E" BorderThickness="0,0,0,1" Padding="6,4">
      <DockPanel LastChildFill="True">
        <ToggleButton x:Name="PowerButton" Classes="panel" DockPanel.Dock="Left" MinWidth="70" FontWeight="Bold" Content="POWER" />
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
          <ComboBox x:Name="RadioBox" MinWidth="300" PlaceholderText="No radio found - press Discover" />
          <Button x:Name="DiscoverButton" Content="Discover" />
          <TextBlock Text="Model" VerticalAlignment="Center" Foreground="#9AA4AE" />
          <ComboBox x:Name="ModelBox" MinWidth="130" />
        </StackPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#9AA4AE" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- bottom bar: PC audio routing -->
    <Border DockPanel.Dock="Bottom" Background="#161C22" BorderBrush="#2C353E" BorderThickness="0,1,0,0" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox x:Name="PcAudioCheck" Content="PC audio" VerticalAlignment="Center" />
        <ComboBox x:Name="HostApiBox" MinWidth="120" />
        <ComboBox x:Name="OutputDeviceBox" MinWidth="320" />
        <TextBlock Text="Sample rate" VerticalAlignment="Center" Foreground="#9AA4AE" Margin="12,0,0,0" />
        <ComboBox x:Name="SampleRateBox" MinWidth="100" />
        <TextBlock x:Name="SyncText" VerticalAlignment="Center" Foreground="#9AA4AE" Margin="12,0,0,0" />
      </StackPanel>
    </Border>

    <!-- right column: meter and receiver controls -->
    <ScrollViewer DockPanel.Dock="Right" Width="290" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Classes="group">
          <StackPanel>
            <c:SMeter x:Name="Meter" Height="46" />
            <TextBlock x:Name="MeterText" HorizontalAlignment="Right" FontFamily="DejaVu Sans Mono, monospace" Foreground="#C5CED6" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="caption" Text="AF (volume)" />
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" />
            <TextBlock Classes="caption" Text="AGC" />
            <WrapPanel x:Name="AgcPanel" />
            <TextBlock Classes="caption" x:Name="AgcTopCaption" Text="AGC gain" />
            <Slider x:Name="AgcTopSlider" Minimum="-20" Maximum="120" />
            <TextBlock Classes="caption" Text="Noise" />
            <WrapPanel>
              <ToggleButton x:Name="NrToggle" Classes="panel" Content="NR2" ToolTip.Tip="Spectral noise reduction" />
              <ToggleButton x:Name="AnfToggle" Classes="panel" Content="ANF" ToolTip.Tip="Automatic notch filter" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="caption" Text="Tuning step" />
            <ComboBox x:Name="StepBox" HorizontalAlignment="Stretch" />
            <TextBlock Classes="caption" Text="Panadapter zoom" />
            <Slider x:Name="ZoomSlider" Minimum="0" Maximum="100" />
            <TextBlock Classes="caption" Text="Wheel: tune   Ctrl+wheel: move scale   Shift+wheel: range" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- VFO, band, mode, filter -->
    <Border DockPanel.Dock="Top" Classes="group">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Grid.Column="0" Margin="4,0,16,0">
          <Panel>
            <c:FrequencyDisplay x:Name="Vfo" />
            <TextBox x:Name="VfoEdit" IsVisible="False" FontSize="28" Watermark="MHz, e.g. 14.074" VerticalAlignment="Center" />
          </Panel>
          <TextBlock x:Name="VfoInfo" Foreground="#9AA4AE" FontSize="12" Margin="4,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <WrapPanel x:Name="BandPanel" />
          <WrapPanel x:Name="ModePanel" />
          <WrapPanel x:Name="FilterPanel" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- panadapter + waterfall -->
    <Border Classes="group" Padding="0">
      <c:PanafallView x:Name="Panafall" />
    </Border>
  </DockPanel>
</Window>
