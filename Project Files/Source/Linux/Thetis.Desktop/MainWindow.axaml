<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Thetis.Desktop.Controls"
        x:Class="Thetis.Desktop.MainWindow"
        Title="Thetis"
        Icon="/Assets/thetis.png"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Background="#12171C">

  <DockPanel>

    <!-- menu bar: every option, built in MainWindow.Menu.cs -->
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="#161C22" />

    <!-- top bar: power, radio selection, status -->
    <Border DockPanel.Dock="Top" Background="#161C22" BorderBrush="#2C353E" BorderThickness="0,0,0,1" Padding="6,4">
      <DockPanel LastChildFill="True">
        <ToggleButton x:Name="PowerButton" Classes="panel" DockPanel.Dock="Left" MinWidth="70" FontWeight="Bold" Content="POWER" />
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
          <ComboBox x:Name="RadioBox" MinWidth="300" PlaceholderText="No radio found - press Discover" />
          <Button x:Name="DiscoverButton" Content="Discover" />
          <TextBlock Text="Model" VerticalAlignment="Center" Foreground="#9AA4AE" />
          <ComboBox x:Name="ModelBox" MinWidth="130" />
          <Button x:Name="SetupButton" Content="Setup" ToolTip.Tip="Calibration, PA gain, filters and antennas" />
        </StackPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#9AA4AE" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- bottom bar: PC audio routing -->
    <Border DockPanel.Dock="Bottom" Background="#161C22" BorderBrush="#2C353E" BorderThickness="0,1,0,0" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox x:Name="PcAudioCheck" Content="PC audio" VerticalAlignment="Center" />
        <ComboBox x:Name="HostApiBox" MinWidth="120" />
        <ComboBox x:Name="OutputDeviceBox" MinWidth="320" />
        <TextBlock Text="Mic in" VerticalAlignment="Center" Foreground="#9AA4AE" Margin="12,0,0,0" />
        <ComboBox x:Name="InputDeviceBox" MinWidth="220" ToolTip.Tip="PC microphone, used when Microphone is set to PC" />
        <TextBlock Text="Sample rate" VerticalAlignment="Center" Foreground="#9AA4AE" Margin="12,0,0,0" />
        <ComboBox x:Name="SampleRateBox" MinWidth="100" />
        <TextBlock x:Name="SyncText" VerticalAlignment="Center" Foreground="#9AA4AE" Margin="12,0,0,0" />
      </StackPanel>
    </Border>

    <!-- right column: meter and receiver controls -->
    <ScrollViewer DockPanel.Dock="Right" Width="290" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Classes="group">
          <StackPanel>
            <c:SMeter x:Name="Meter" Height="46" />
            <TextBlock x:Name="MeterText" HorizontalAlignment="Right" FontFamily="DejaVu Sans Mono, monospace" Foreground="#C5CED6" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <ToggleButton x:Name="MoxButton" Classes="tx" Content="MOX" ToolTip.Tip="Transmit (the radio's PTT input also keys it)" />
              <ToggleButton x:Name="TuneButton" Classes="tx" Content="TUNE" ToolTip.Tip="Send a steady carrier at the tune power" />
            </StackPanel>
            <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
              <ToggleButton x:Name="VoxToggle" Classes="panel" Content="VOX" ToolTip.Tip="Voice-operated transmit (threshold and hold under Setup, Transmit audio)" />
              <ToggleButton x:Name="CompToggle" Classes="panel" Content="COMP" ToolTip.Tip="Speech compressor (level under Setup, Transmit audio)" />
              <ToggleButton x:Name="EqToggle" Classes="panel" Content="EQ" ToolTip.Tip="Transmit equaliser (bands under Setup, Transmit audio)" />
              <ToggleButton x:Name="TxPanelToggle" Classes="panel" Content="AUDIO" ToolTip.Tip="The transmit audio panel: EQ, leveler, compressor, CFC, VOX, meters (View menu)" />
              <ToggleButton x:Name="PsToggle" Classes="panel" Content="PS-A" ToolTip.Tip="PureSignal: correct the amplifier's distortion, calibrating continuously while transmitting (Setup, PureSignal)" />
              <ToggleButton x:Name="TwoToneToggle" Classes="tx" Content="2-TONE" MinWidth="60" Height="26" FontSize="11" ToolTip.Tip="Transmit the two-tone test signal (for PureSignal calibration and IMD tests)" />
            </WrapPanel>
            <TextBlock x:Name="PsStatusText" HorizontalAlignment="Center" FontSize="11" Margin="0,2,0,0" IsVisible="False" TextWrapping="Wrap" />
            <TextBlock x:Name="TxMeterText" HorizontalAlignment="Center" FontFamily="DejaVu Sans Mono, monospace" Foreground="#C5CED6" Margin="0,4,0,0" />
            <TextBlock x:Name="TxWarning" Classes="warn" IsVisible="False" />
            <TextBlock Classes="caption" x:Name="DriveCaption" Text="Drive" />
            <Slider x:Name="DriveSlider" Minimum="0" Maximum="100" />
            <TextBlock Classes="caption" x:Name="TunePowerCaption" Text="Tune power" />
            <Slider x:Name="TunePowerSlider" Minimum="0" Maximum="100" />
            <TextBlock Classes="caption" x:Name="MicGainCaption" Text="Mic gain" />
            <Slider x:Name="MicGainSlider" Minimum="-40" Maximum="70" />
            <TextBlock Classes="caption" Text="Microphone" />
            <ComboBox x:Name="MicSourceBox" HorizontalAlignment="Stretch" />
            <Expander x:Name="TxSettingsExpander" Header="Transmit settings" HorizontalAlignment="Stretch" Margin="0,6,0,0">
              <StackPanel>
                <CheckBox x:Name="TxEnableCheck" Content="Allow transmitting" />
                <TextBlock Classes="caption" Text="Region (limits transmit to the amateur bands)" TextWrapping="Wrap" />
                <ComboBox x:Name="RegionBox" HorizontalAlignment="Stretch" />
                <TextBlock Classes="caption" Text="Transmit filter (Hz)" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <NumericUpDown x:Name="TxLowBox" Minimum="0" Maximum="1000" Increment="50" FormatString="0" Width="110" />
                  <NumericUpDown x:Name="TxHighBox" Minimum="1000" Maximum="10000" Increment="100" FormatString="0" Width="120" />
                </StackPanel>
                <TextBlock Classes="caption" Text="Transmit timeout (s, 0 = off)" />
                <NumericUpDown x:Name="TxTimeoutBox" Minimum="0" Maximum="3600" Increment="30" FormatString="0" HorizontalAlignment="Stretch" />
                <CheckBox x:Name="RadioPttCheck" Content="Key from the radio's PTT input" />
                <CheckBox x:Name="SwrProtectCheck" Content="SWR protection" />
                <CheckBox x:Name="N2adrCheck" Content="HL2: N2ADR filter board" ToolTip.Tip="Open-collector outputs for the N2ADR filter board (Hermes-Lite 2). Takes effect at the next power on." />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="caption" x:Name="AttCaption" Text="Attenuator" ToolTip.Tip="Receive attenuator, remembered per band" />
            <Slider x:Name="AttSlider" Minimum="0" Maximum="31" TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Classes="caption" Text="AF (volume)" />
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" />
            <TextBlock Classes="caption" Text="AGC" />
            <WrapPanel x:Name="AgcPanel" />
            <TextBlock Classes="caption" x:Name="AgcTopCaption" Text="AGC gain" TextWrapping="Wrap"
                       ToolTip.Tip="The most the AGC may amplify the signal (the console's AGC-T). Not a volume control: use AF for that. Usually 80-90 dB." />
            <Slider x:Name="AgcTopSlider" Minimum="-20" Maximum="120" />
            <TextBlock Classes="caption" x:Name="NoiseCaption" Text="Noise reduction" />
            <WrapPanel>
              <WrapPanel x:Name="NrPanel" />
              <ToggleButton x:Name="AnfToggle" Classes="panel" Content="ANF" ToolTip.Tip="Automatic notch filter" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="caption" Text="Tuning step" />
            <ComboBox x:Name="StepBox" HorizontalAlignment="Stretch" />
            <TextBlock Classes="caption" Text="Panadapter zoom" />
            <Slider x:Name="ZoomSlider" Minimum="0" Maximum="100" />
            <TextBlock Classes="caption" Text="Wheel: tune   Ctrl+wheel: move scale   Shift+wheel: range" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- VFO, band, mode, filter -->
    <Border DockPanel.Dock="Top" Classes="group">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Grid.Column="0" Margin="4,0,16,0">
          <Panel>
            <c:FrequencyDisplay x:Name="Vfo" />
            <TextBox x:Name="VfoEdit" IsVisible="False" FontSize="28" Watermark="MHz, e.g. 14.074" VerticalAlignment="Center" />
          </Panel>
          <TextBlock x:Name="VfoInfo" Foreground="#9AA4AE" FontSize="12" Margin="4,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <WrapPanel x:Name="BandPanel" />
          <WrapPanel x:Name="ModePanel" />
          <WrapPanel x:Name="FilterPanel" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- panadapter + waterfall, with the docking places for the transmit audio panel
         (MainWindow.TxPanel.cs sets the widths and heights) -->
    <Grid x:Name="WorkArea" ColumnDefinitions="0,Auto,*,Auto,0" RowDefinitions="*,Auto,0">
      <ContentControl x:Name="LeftDock" Grid.Column="0" />
      <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="5" IsVisible="False" ResizeDirection="Columns" Background="#2C353E" />
      <Border Grid.Column="2" Classes="group" Padding="0">
        <c:PanafallView x:Name="Panafall" />
      </Border>
      <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="5" IsVisible="False" ResizeDirection="Columns" Background="#2C353E" />
      <ContentControl x:Name="RightDock" Grid.Column="4" />
      <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Grid.ColumnSpan="5" Height="5" IsVisible="False" ResizeDirection="Rows" Background="#2C353E" />
      <ContentControl x:Name="BottomDock" Grid.Row="2" Grid.ColumnSpan="5" />
    </Grid>
  </DockPanel>
</Window>
